{
  "name": "setsuzei",
  "version": "0.6.1",
  "mcpName": "io.github.ozko00/setsuzei",
  "description": "MCP server & CLI that estimates Japanese income tax and resident tax for freelancers: furusato nozei limit, iDeCo, deductions, and tax return (kakutei shinkoku) boxes. Cited from primary sources, tested, local-only. 所得税・住民税・ふるさと納税・確定申告",
  "license": "MIT",
  "homepage": "https://github.com/ozko00/setsuzei#readme",
  "bugs": {
    "url": "https://github.com/ozko00/setsuzei/issues"
  },
  "author": "Kosuke Ozawa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozko00/setsuzei.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "agent",
    "ai-agent",
    "agent-skill",
    "japan",
    "japanese",
    "tax",
    "income-tax",
    "resident-tax",
    "tax-calculator",
    "furusato",
    "furusato-nozei",
    "ideco",
    "kakutei-shinkoku",
    "freelance",
    "cli",
    "節税",
    "確定申告",
    "ふるさと納税"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "config": {
    "npmPinned": "0.6.1"
  },
  "bin": {
    "setsuzei": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "test:browser": "npm run build && node --test test/browser/e2e.mjs",
    "prepare": "npm run build",
    "build:site": "tsc -p tsconfig.web.json && tsc -p tsconfig.test.json && node .test-dist/site/build.js",
    "serve:site": "python3 -m http.server 8080 --bind 127.0.0.1 --directory docs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0"
  }
}
