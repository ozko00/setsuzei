{
  "name": "setsuzei",
  "version": "0.3.2",
  "description": "年末までに、あと何をすればいくら税金が減るかを概算する CLI / ライブラリ / Agent Skill（フリーランス・副業向け、令和8年分）",
  "license": "MIT",
  "author": "Kosuke Ozawa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozko00/setsuzei.git"
  },
  "keywords": [
    "tax",
    "japan",
    "freelance",
    "furusato-nozei",
    "ideco",
    "cli",
    "agent-skill",
    "節税",
    "確定申告",
    "ふるさと納税"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "config": {
    "npmPinned": "0.3.1"
  },
  "bin": {
    "setsuzei": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "test:browser": "npm run build && node --test test/browser/e2e.mjs",
    "prepare": "npm run build",
    "build:site": "tsc -p tsconfig.web.json && tsc -p tsconfig.test.json && node .test-dist/site/build.js",
    "serve:site": "python3 -m http.server 8080 --bind 127.0.0.1 --directory docs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0"
  }
}
